# Application Information
APP_NAME="Real-Time People Counting and Crowd Density Estimation System"
APP_VERSION="1.0.0"
DEBUG=True

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://127.0.0.1:3000"]

# Frontend Connection URLs
VITE_API_URL=http://127.0.0.1:8000
VITE_WS_URL=ws://127.0.0.1:8000

# Compute Device: 'cpu' or 'cuda' (auto-fallback to cpu if cuda unavailable)
DEVICE=cpu

# Model Paths & Tracker Selection
DETECTION_MODEL_PATH=models/detection/yolov8n.pt
DENSITY_MODEL_PATH=models/density/mcnn_shanghaitech.pth
TRACKER_TYPE=bytetrack
# Supported Trackers: bytetrack, botsort

# Detection and Tracking Hyperparameters
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
INPUT_IMAGE_SIZE=640
MAX_DETECTIONS=300
TRACK_BUFFER_FRAMES=30

# Video Stream Processing Settings
WEBCAM_INDEX=0
FRAME_SKIP=0
VIDEO_QUEUE_SIZE=30
SAVE_ANNOTATED_VIDEO=False

# Analytics & Crowd Alert Thresholds
MODERATE_CROWD_THRESHOLD=10
HIGH_CROWD_THRESHOLD=25
CRITICAL_CROWD_THRESHOLD=50
ALERT_COOLDOWN_SECONDS=15.0
ANALYTICS_SNAPSHOT_INTERVAL_SEC=2.0

# Database Persistence & Retention
DATABASE_URL=sqlite:///./outputs/crowd_system.db
DATA_RETENTION_DAYS=30
